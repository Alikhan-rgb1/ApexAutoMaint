{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["node"],
      "phases": {
        "install": {
          "cmds": ["cd apex-automaint-backend && npm ci"]
        },
        "build": {
          "dependsOn": ["install"],
          "cmds": ["cd apex-automaint-backend && npm run build"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "cd apex-automaint-backend && npm run start:prod"
  }
}
